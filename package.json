{
  "name": "revenue-cat-unofficial-client",
  "version": "2.2.2",
  "description": "Type-safe RevenueCat REST API v2 client for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prebuild": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "revenuecat",
    "subscriptions",
    "iap",
    "in-app-purchases",
    "apple",
    "google-play",
    "stripe",
    "api-client",
    "typescript",
    "v2"
  ],
  "author": "Swapnanil Dhol <swapnanildhol@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SwapnanilDhol/revenue-cat-unofficial-client"
  },
  "engines": {
    "node": ">=18"
  }
}
